# ---- HEAT-SHIELD AI configuration (copy to .env and adjust) ----

# Database. Two supported modes:
# 1) Supabase Postgres (production path):
#    DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECTREF>.supabase.co:5432/postgres
# 2) Local demo default (no setup needed): leave unset -> SQLite at backend/heatshield.db
DATABASE_URL=

# Supabase (optional; used for hosted deployment)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480

# CORS (frontend origin)
FRONTEND_ORIGIN=http://localhost:3000

# Seeding
# Anchor "now" for the demo dataset (ISO 8601). Empty = run time.
SEED_NOW_ANCHOR=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
